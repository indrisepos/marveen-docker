# Copy to .env (setup.sh does this for you) and adjust.

# ── Upstream ────────────────────────────────────────────────────────────────
# Pin the Marveen version this deployment was verified against. A branch name
# works too, but then a rebuild is not reproducible.
MARVEEN_REPO=https://github.com/Szotasz/marveen.git
MARVEEN_REF=main

# ── Identity ────────────────────────────────────────────────────────────────
# Must match the user owning ./marveen and ./data, or the container writes
# files you cannot edit. setup.sh fills these in from `id`.
HOST_UID=1000
HOST_GID=1000

# ── Locale ──────────────────────────────────────────────────────────────────
# The image generates en_US.UTF-8 and hu_HU.UTF-8. Marveen's installer and UI
# are Hungarian-first; en_US.UTF-8 is the safe default elsewhere.
TZ=Europe/Budapest
LANG=en_US.UTF-8

# ── Dashboard ───────────────────────────────────────────────────────────────
# Published on loopback only. Change the host part at your own risk: the
# dashboard's auth is a bearer token in the URL.
WEB_PORT=3420

# ── Pinned toolchain ────────────────────────────────────────────────────────
# CLAUDE_VERSION tracks the CLAUDE_PIN in Marveen's install-linux.sh -- the
# version upstream tests against. GO_VERSION only feeds the bumblebee scanner.
CLAUDE_VERSION=2.1.110
GO_VERSION=1.25.1
